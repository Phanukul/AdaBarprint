{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AdaBarprint",
  "version": "0.2.1",
  "identifier": "com.adasoft.adabarprint",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173/AdaBarprint",
    "beforeBuildCommand": "node scripts/build-desktop.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "nsis/hooks.nsh"
      }
    }
  }
}
